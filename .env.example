# このファイルをコピーして .env を作り、実際の値を入れてください。
# .env はGitには保存されません(.gitignoreで除外済み)。
cp_note="cp .env.example .env"

# --- Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# --- コスト管理 ---
# 月間のAPI利用上限(円)。80%到達で新規生成停止、100%到達で全停止。
MONTHLY_BUDGET_JPY=3000
# ドル円レート。実勢より高めにしておくと予算超過を防ぎやすい。
USD_JPY_RATE=160

# --- Google スプレッドシート/Drive (Phase2後半で使用) ---
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./service-account.json

# --- Instagram Graph API (Phase3で使用) ---
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# --- YouTube Data API (Phase3で使用) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- GA4 (Phase5で使用) ---
GA4_MEASUREMENT_ID=
