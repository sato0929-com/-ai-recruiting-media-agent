# このファイルをコピーして .env を作り、実際の値を入れてください。
# .env はGitには保存されません(.gitignoreで除外済み)。
cp_note="cp .env.example .env"

# --- Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# --- コスト管理 ---
# 月間のAPI利用上限(円)。80%到達で新規生成停止、100%到達で全停止。
MONTHLY_BUDGET_JPY=3000
# ドル円レート。実勢より高めにしておくと予算超過を防ぎやすい。
USD_JPY_RATE=160

# --- Google スプレッドシート ---
# 認証は鍵ファイルを使わずWorkload Identity Federationで行う
# (docs/setup/05_workload_identity_federation.md 参照)。
# ローカル実行時は先に `gcloud auth application-default login --project recruiting-media-agent` を実行する。
GOOGLE_SHEETS_SPREADSHEET_ID=1J8BbmvBYBRHQXKBlyGQgs3jA_GN4XhkKdhvshvcLJ3c

# --- Instagram Graph API (Phase3で使用) ---
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# --- YouTube Data API (Phase3で使用) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- GA4 (Phase5で使用) ---
GA4_MEASUREMENT_ID=
